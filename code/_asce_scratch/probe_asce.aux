\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Topic quality on the civil engineering corpus (unified evaluation vocabulary, ten words per topic; values are means over seeds 11/23/37, and the training procedure differs across algorithm families as described in the ``Baselines, training protocols and metrics'' subsection; BERTopic and Top2Vec choose their own topic numbers and are shown for reference).}}{32}{table.caption.24}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:civil}{{1}{32}{Topic quality on the civil engineering corpus (unified evaluation vocabulary, ten words per topic; values are means over seeds 11/23/37, and the training procedure differs across algorithm families as described in the ``Baselines, training protocols and metrics'' subsection; BERTopic and Top2Vec choose their own topic numbers and are shown for reference)}{table.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Topic quality on AG News (unified evaluation vocabulary, ten words per topic; values are means over seeds 11/23/37 where applicable, and the training procedure differs across algorithm families as described in the ``Baselines, training protocols and metrics'' subsection; BERTopic and Top2Vec choose their own topic numbers and are shown for reference).}}{33}{table.caption.25}\protected@file@percent }
\newlabel{tab:agnews}{{2}{33}{Topic quality on AG News (unified evaluation vocabulary, ten words per topic; values are means over seeds 11/23/37 where applicable, and the training procedure differs across algorithm families as described in the ``Baselines, training protocols and metrics'' subsection; BERTopic and Top2Vec choose their own topic numbers and are shown for reference)}{table.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Topic quality on GitHub issues (same evaluation protocol and read-outs as Table~\ref {tab:agnews}; the FC-NTM rows, BTM, ETM, CombinedTM, ProdLDA and CTM-lite are three-seed results).}}{34}{table.caption.26}\protected@file@percent }
\newlabel{tab:github}{{3}{34}{Topic quality on GitHub issues (same evaluation protocol and read-outs as Table~\ref {tab:agnews}; the FC-NTM rows, BTM, ETM, CombinedTM, ProdLDA and CTM-lite are three-seed results)}{table.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Read-out comparison ($K=30$, means over seeds 11/23/37). Each model is first read out through its own topic--word matrix ($\beta $ read-out) and then through a class TF--IDF read-out aggregated from its training-set posterior $\theta $; BTM enters the same read-out through the point-estimate document--topic posterior of its original Section 3.3, and the FC-NTM row is the same model as in Tables~\ref {tab:agnews} and~\ref {tab:github}.}}{35}{table.caption.27}\protected@file@percent }
\newlabel{tab:fair}{{4}{35}{Read-out comparison ($K=30$, means over seeds 11/23/37). Each model is first read out through its own topic--word matrix ($\beta $ read-out) and then through a class TF--IDF read-out aggregated from its training-set posterior $\theta $; BTM enters the same read-out through the point-estimate document--topic posterior of its original Section 3.3, and the FC-NTM row is the same model as in Tables~\ref {tab:agnews} and~\ref {tab:github}}{table.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Ten-seed paired comparison of FC-NTM{} and BTM on the three corpora. The read-out rows report $C_V$ differences (FC-NTM{} minus BTM at the same read-out); the occlusion rows compare the relative degradation $\mathrm  {NLL}(100\%)/\mathrm  {NLL}(25\%)$, so a positive value means FC-NTM{} is more stable. The occlusion rows use the pre-selected baselines (BTM on all three corpora and additionally LDA on AG News) rather than a full baseline tournament. CIs are two-sided $t$ intervals; sign and Wilcoxon tests are two-sided.}}{36}{table.caption.28}\protected@file@percent }
\newlabel{tab:seed-paired}{{5}{36}{Ten-seed paired comparison of \fcntm {} and BTM on the three corpora. The read-out rows report $C_V$ differences (\fcntm {} minus BTM at the same read-out); the occlusion rows compare the relative degradation $\mathrm {NLL}(100\%)/\mathrm {NLL}(25\%)$, so a positive value means \fcntm {} is more stable. The occlusion rows use the pre-selected baselines (BTM on all three corpora and additionally LDA on AG News) rather than a full baseline tournament. CIs are two-sided $t$ intervals; sign and Wilcoxon tests are two-sided}{table.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Field redundancy, measured occlusion gap and the $C_V$ difference against BTM on two corpora. Redundancy is fitted on the training split and evaluated on the test split and includes constructive controls (exact copy $=1.000$, cross-document shuffle $\approx 0.000$); the occlusion $\Delta C_V$ is the mean$\pm $standard deviation over seeds 11/23/37 with dropout training. The last column gives the $C_V$ difference under the matched class TF--IDF read-out and under BTM's native $\beta $ read-out.}}{37}{table.caption.29}\protected@file@percent }
\newlabel{tab:conditional}{{6}{37}{Field redundancy, measured occlusion gap and the $C_V$ difference against BTM on two corpora. Redundancy is fitted on the training split and evaluated on the test split and includes constructive controls (exact copy $=1.000$, cross-document shuffle $\approx 0.000$); the occlusion $\Delta C_V$ is the mean$\pm $standard deviation over seeds 11/23/37 with dropout training. The last column gives the $C_V$ difference under the matched class TF--IDF read-out and under BTM's native $\beta $ read-out}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Partial-occlusion curves on GitHub issues (seed 11). NLL is the per-token negative log-likelihood of the occluded background tokens (lower is better); relative degradation is $\mathrm  {NLL}(100\%)/\mathrm  {NLL}(25\%)$; agreement is the fraction of documents whose most probable topic is unchanged at 100\% occlusion relative to the unoccluded ($p=0$) inference. BTM enters the protocol through the document--topic posterior of its Section 3.3.}}{38}{table.caption.30}\protected@file@percent }
\newlabel{tab:occl-robust}{{7}{38}{Partial-occlusion curves on GitHub issues (seed 11). NLL is the per-token negative log-likelihood of the occluded background tokens (lower is better); relative degradation is $\mathrm {NLL}(100\%)/\mathrm {NLL}(25\%)$; agreement is the fraction of documents whose most probable topic is unchanged at 100\% occlusion relative to the unoccluded ($p=0$) inference. BTM enters the protocol through the document--topic posterior of its Section 3.3}{table.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Partial-occlusion behaviour on the three corpora (seeds 11/23/37, mean$\pm $standard deviation; the mask is redrawn per seed). Bold marks the smallest relative degradation per corpus. Field asymmetry is described by the mean background/summary token ratio and by the token-type share of background words that do not occur in the summary of the same document.}}{39}{table.caption.31}\protected@file@percent }
\newlabel{tab:occl-cross}{{8}{39}{Partial-occlusion behaviour on the three corpora (seeds 11/23/37, mean$\pm $standard deviation; the mask is redrawn per seed). Bold marks the smallest relative degradation per corpus. Field asymmetry is described by the mean background/summary token ratio and by the token-type share of background words that do not occur in the summary of the same document}{table.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Field-restricted read-out ($C_V$, mean$\pm $standard deviation over seeds 11/23/37). Every topic--word matrix is truncated to the vocabulary of one field and scored against that field's test text only; ``background view'' is the abstract/body side and ``summary view'' the title side. FC-NTM's summary view is scored on 20--22 scorable topics per seed on GitHub (29--30 on AG News, 26--28 on the civil corpus) because topics whose ten field words never occur in the held-out text get an undefined $C_V$.}}{40}{table.caption.32}\protected@file@percent }
\newlabel{tab:fieldview-baselines}{{9}{40}{Field-restricted read-out ($C_V$, mean$\pm $standard deviation over seeds 11/23/37). Every topic--word matrix is truncated to the vocabulary of one field and scored against that field's test text only; ``background view'' is the abstract/body side and ``summary view'' the title side. FC-NTM's summary view is scored on 20--22 scorable topics per seed on GitHub (29--30 on AG News, 26--28 on the civil corpus) because topics whose ten field words never occur in the held-out text get an undefined $C_V$}{table.caption.32}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Three-step fusion ablation on GitHub issues ($K=30$, seeds 11/23/37, same protocol). Within one read-out each row changes exactly one thing: first the fused mixture $\theta _{\mathrm  {fuse}}$ is decoded into the reconstruction term (mean fusion), then mean fusion is replaced by a learnable gate (the main model). ``Positive pairs'' counts the seeds whose paired difference against the row above is positive ($C_V$, NPMI).}}{41}{table.caption.33}\protected@file@percent }
\newlabel{tab:fusion}{{10}{41}{Three-step fusion ablation on GitHub issues ($K=30$, seeds 11/23/37, same protocol). Within one read-out each row changes exactly one thing: first the fused mixture $\theta _{\mathrm {fuse}}$ is decoded into the reconstruction term (mean fusion), then mean fusion is replaced by a learnable gate (the main model). ``Positive pairs'' counts the seeds whose paired difference against the row above is positive ($C_V$, NPMI)}{table.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Core-component ablation on three corpora and two read-outs ($K=30$, seeds 11/23/37, 700-epoch budget, all other settings identical to the main model). Each column switches off one component: cross-field reconstruction of both streams, the JS consistency weight, field-level word masking, and whole-field dropout; the fusion-reconstruction term is kept in all columns. Values are mean paired $\Delta C_V$ (negative means the component matters), parentheses count positive pairs.}}{42}{table.caption.34}\protected@file@percent }
\newlabel{tab:core-ablation}{{11}{42}{Core-component ablation on three corpora and two read-outs ($K=30$, seeds 11/23/37, 700-epoch budget, all other settings identical to the main model). Each column switches off one component: cross-field reconstruction of both streams, the JS consistency weight, field-level word masking, and whole-field dropout; the fusion-reconstruction term is kept in all columns. Values are mean paired $\Delta C_V$ (negative means the component matters), parentheses count positive pairs}{table.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Sensitivity to the fusion-reconstruction weight $\lambda _f$ on GitHub issues (gated fusion, seeds 11/23/37). $\lambda _f=0$ is the no-fusion setting, $\lambda _f=0.5$ is the value used throughout; all other settings match the main model.}}{43}{table.caption.35}\protected@file@percent }
\newlabel{tab:weight}{{12}{43}{Sensitivity to the fusion-reconstruction weight $\lambda _f$ on GitHub issues (gated fusion, seeds 11/23/37). $\lambda _f=0$ is the no-fusion setting, $\lambda _f=0.5$ is the value used throughout; all other settings match the main model}{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Whole-field occlusion at inference time ($K=30$, final configuration, 700-epoch budget). $\Delta C_V$ is the coherence difference between full-field and occluded inference under the same read-out; $\Delta \mathrm  {NLL}$ is the per-token increase; agreement is the fraction of documents whose most probable topic is unchanged. The two rows of a corpus use the same seeds, isolating the effect of the training-time dropout setting.}}{44}{table.caption.36}\protected@file@percent }
\newlabel{tab:occlusion}{{13}{44}{Whole-field occlusion at inference time ($K=30$, final configuration, 700-epoch budget). $\Delta C_V$ is the coherence difference between full-field and occluded inference under the same read-out; $\Delta \mathrm {NLL}$ is the per-token increase; agreement is the fraction of documents whose most probable topic is unchanged. The two rows of a corpus use the same seeds, isolating the effect of the training-time dropout setting}{table.caption.36}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Concatenated-field single-encoder control (seeds 11/23/37; same budget, vocabulary and read-outs). $\Delta $ is FC-NTM{} minus the control, with positive pairs in parentheses.}}{45}{table.caption.37}\protected@file@percent }
\newlabel{tab:concat}{{14}{45}{Concatenated-field single-encoder control (seeds 11/23/37; same budget, vocabulary and read-outs). $\Delta $ is \fcntm {} minus the control, with positive pairs in parentheses}{table.caption.37}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Title-only routing to the 15 most frequent OpenAlex topics of the civil corpus (seeds 11/23/37; 857 test records, coverage 42.9\%). The TF--IDF classifier is supervised and serves as a reference point, not as a topic model.}}{46}{table.caption.38}\protected@file@percent }
\newlabel{tab:archival}{{15}{46}{Title-only routing to the 15 most frequent OpenAlex topics of the civil corpus (seeds 11/23/37; 857 test records, coverage 42.9\%). The TF--IDF classifier is supervised and serves as a reference point, not as a topic model}{table.caption.38}{}}
\def\@LN@column{1}
