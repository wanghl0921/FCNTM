\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Main results on the two public corpora (unified evaluation vocabulary, ten words per topic). Left: $C_V$; right: NPMI. Error bars are standard deviations across seeds. The FC-NTM{} rows, BTM and ETM on GitHub and the FC-NTM{} rows on AG News are three-seed results; CombinedTM, ProdLDA and CTM-lite were run for the same seeds 11/23/37 under the same protocol.}}{49}{figure.caption.39}\protected@file@percent }
\newlabel{fig:main}{{1}{49}{Main results on the two public corpora (unified evaluation vocabulary, ten words per topic). Left: $C_V$; right: NPMI. Error bars are standard deviations across seeds. The \fcntm {} rows, BTM and ETM on GitHub and the \fcntm {} rows on AG News are three-seed results; CombinedTM, ProdLDA and CTM-lite were run for the same seeds 11/23/37 under the same protocol}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Field redundancy and gain (held-out measures). Left: squared canonical correlation $\rho ^2_{\mathrm  {cca}}$ (higher means more redundant; fitted on the training split and evaluated on the test split); middle: the $\Delta C_V$ of the real occlusion diagnostic (GitHub $+0.009\pm 0.022$, AG News $+0.018\pm 0.013$, three seeds each); right: the $C_V$ difference between FC-NTM{}-cTFIDF and BTM under the matched read-out (GitHub $+0.027$, AG News $+0.019$). The two corpora have similar redundancy, while the ten-seed gain is positive on GitHub only (AG News $-0.009$), so the figure does not support a redundancy-based prediction of the gain.}}{50}{figure.caption.40}\protected@file@percent }
\newlabel{fig:cond}{{2}{50}{Field redundancy and gain (held-out measures). Left: squared canonical correlation $\rho ^2_{\mathrm {cca}}$ (higher means more redundant; fitted on the training split and evaluated on the test split); middle: the $\Delta C_V$ of the real occlusion diagnostic (GitHub $+0.009\pm 0.022$, AG News $+0.018\pm 0.013$, three seeds each); right: the $C_V$ difference between \fcntm {}-cTFIDF and BTM under the matched read-out (GitHub $+0.027$, AG News $+0.019$). The two corpora have similar redundancy, while the ten-seed gain is positive on GitHub only (AG News $-0.009$), so the figure does not support a redundancy-based prediction of the gain}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Inference behaviour under partial occlusion of the background field (GitHub issues, seed 11, 2000 test documents). Left: per-token negative log-likelihood of the occluded tokens; right: relative degradation $\mathrm  {NLL}(p)/\mathrm  {NLL}(0.25)$, which summarises the relative increase from the 25\% condition without removing calibration differences. FC-NTM{} is trained with whole-field dropout at $p=0.5$ and has the smallest relative degradation ($\times 1.032$); the ratio itself cannot separate ``recovering content from the summary'' from ``being insensitive to the input'', and the absolute NLL and agreement are not the best, as reported in the text.}}{51}{figure.caption.41}\protected@file@percent }
\newlabel{fig:occlusion}{{3}{51}{Inference behaviour under partial occlusion of the background field (GitHub issues, seed 11, 2000 test documents). Left: per-token negative log-likelihood of the occluded tokens; right: relative degradation $\mathrm {NLL}(p)/\mathrm {NLL}(0.25)$, which summarises the relative increase from the 25\% condition without removing calibration differences. \fcntm {} is trained with whole-field dropout at $p=0.5$ and has the smallest relative degradation ($\times 1.032$); the ratio itself cannot separate ``recovering content from the summary'' from ``being insensitive to the input'', and the absolute NLL and agreement are not the best, as reported in the text}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Relative degradation under the same partial-occlusion protocol on three corpora (curves are means, shading is $\pm 1$ standard deviation; FC-NTM{}, BTM and LDA cover the ten seeds 11--139, the remaining baselines keep the archived seeds 11/23/37). Left: GitHub issues (background to summary length ratio $\approx 12.9$); middle: civil engineering corpus ($\approx 11.2$); right: AG News ($\approx 3.9$). Only on GitHub is the degradation of FC-NTM{} clearly below all baselines; on the civil corpus and AG News the smallest degradation belongs to BTM and LDA respectively, and the gap to FC-NTM{} is within 0.003--0.013.}}{52}{figure.caption.42}\protected@file@percent }
\newlabel{fig:occl-cross}{{4}{52}{Relative degradation under the same partial-occlusion protocol on three corpora (curves are means, shading is $\pm 1$ standard deviation; \fcntm {}, BTM and LDA cover the ten seeds 11--139, the remaining baselines keep the archived seeds 11/23/37). Left: GitHub issues (background to summary length ratio $\approx 12.9$); middle: civil engineering corpus ($\approx 11.2$); right: AG News ($\approx 3.9$). Only on GitHub is the degradation of \fcntm {} clearly below all baselines; on the civil corpus and AG News the smallest degradation belongs to BTM and LDA respectively, and the gap to \fcntm {} is within 0.003--0.013}{figure.caption.42}{}}
